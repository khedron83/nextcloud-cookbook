<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.khedron83.NextcloudCookbook</id>
  <name>Nextcloud Cookbook</name>
  <summary>Desktop client for Nextcloud Cookbook</summary>
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-only</project_license>

  <description>
    <p>
      A desktop client for your self-hosted Nextcloud Cookbook instance.
      Browse, edit, and manage your recipes from your desktop.
    </p>
    <ul>
      <li>Browse and search your recipe collection</li>
      <li>View full recipe details with ingredients and instructions</li>
      <li>Create and edit recipes</li>
      <li>Organise recipes by category</li>
      <li>Meal planner</li>
      <li>Import and export recipes</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.khedron83.NextcloudCookbook.desktop</launchable>

  <url type="homepage">https://github.com/khedron83/nextcloud-cookbook</url>
  <url type="bugtracker">https://github.com/khedron83/nextcloud-cookbook/issues</url>

  <provides>
    <binary>nextcloud-cookbook</binary>
  </provides>

  <releases>
    <release version="1.0.0" date="2025-01-01">
      <description>
        <p>Initial release.</p>
      </description>
    </release>
  </releases>

  <content_rating type="oars-1.1"/>
</component>
